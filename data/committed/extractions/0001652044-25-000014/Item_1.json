      "payload": {
        "chunks": [
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "executive_biography",
            "content": "We continue this work under the leadership of Alphabet and Google CEO, Sundar Pichai.",
            "entity_name": "Sundar Pichai",
            "entity_type_entity": "Person",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "segment",
            "content": "Google Services' core products and platforms include ads, Android, Chrome, devices, Gmail, Google Drive, Google Maps, Google Photos, Google Play, Search, and YouTube, with broad and growing adoption by users around the world.",
            "entity_name": "GOOGL Google Services",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "segment",
            "content": "Through our Google Cloud Platform and Google Workspace offerings, Google Cloud generates revenues primarily from consumption-based fees and subscriptions for infrastructure, platform, applications, and other cloud services.",
            "entity_name": "GOOGL Google Cloud",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "segment",
            "content": "Revenues from Other Bets are generated primarily from the sale of healthcare-related services, and internet services.",
            "entity_name": "GOOGL Other Bets",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "esg_commitment",
            "content": "In 2021, we set an ambitious goal to reach net-zero emissions across all of our operations and value chain by 2030.",
            "entity_name": "Alphabet Net-Zero Emissions by 2030",
            "entity_type_entity": "ESGCommitment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "esg_commitment",
            "content": "To make progress toward this effort, we aim to reduce 50% of our combined Scope 1, Scope 2 (market-based), and Scope 3 absolute emissions (compared to our 2019 base year) by 2030, and we plan to invest in nature-based and technology-based carbon removal solutions to neutralize our remaining emissions.",
            "entity_name": "Alphabet 50% Absolute GHG Reduction by 2030",
            "entity_type_entity": "ESGCommitment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "esg_commitment",
            "content": "In 2020, we set a goal to run on 24/7 CFE every hour of every day on every grid where we operate by 2030.",
            "entity_name": "Alphabet 24/7 Carbon-Free Energy by 2030",
            "entity_type_entity": "ESGCommitment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "esg_commitment",
            "content": "Through our products, we have an aspiration to help individuals, cities, and other partners collectively reduce one gigaton of their carbon equivalent emissions annually by 2030.",
            "entity_name": "Alphabet 1 Gigaton Third-Party Emissions Reduction via Products by 2030",
            "entity_type_entity": "ESGCommitment",
            "valid_from": null,
            "valid_until": null
          }
        ],
