            "entity_type_entity": "CapitalReturn",
            "valid_from": "2024-02-21",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_5"
            },
            "chunk_type": "capital_return",
            "content": "From January 29, 2024 to February 16, 2024, we repurchased 2.8 million shares for $1.9 billion pursuant to a Rule 10b5-1 trading plan.",
