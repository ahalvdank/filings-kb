          {
            "attributes": {
              "disclosure_statute": "Section 13(r) Securities Exchange Act of 1934",
              "section_type": "Item_9B"
            },
            "chunk_type": "material_event",
            "content": "during the second quarter of 2025, a non-U.S. subsidiary of the Firm processed three payments, each valued at the equivalent of approximately USD 130, for its client, a non-U.S. person, where the Iranian Embassy in London, U.K. was the beneficiary. The Firm did not charge a fee for these transactions. The payments were for the renewal of travel documentation for the client's three minor children and were therefore exempt transactions pursuant to 31 C.F.R. 560.219(d).",
            "entity_name": "JPM Q2 2025 Iran Embassy Payment Disclosure",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "disclosure_statute": "Section 13(r) Securities Exchange Act of 1934",
              "section_type": "Item_9B"
            },
            "chunk_type": "material_event",
            "content": "during the third quarter of 2025, the Firm determined that an existing account holder at a non-U.S. subsidiary of the Firm had previously become employed by a subsidiary of an entity which is owned or controlled by the Government of Iran. The account was valued at the equivalent of approximately USD 119,000. The Firm's non-U.S. subsidiary charged fees of the equivalent of approximately USD 850 from the time the account holder became employed by the applicable entity through the third quarter of 2025. The Firm has closed the account.",
            "entity_name": "JPM Q3 2025 Iran-Linked Account Closure",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          }
