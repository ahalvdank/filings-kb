      "extracted_at": "2026-06-22T16:13:22Z",
      "payload": {
        "chunks": [
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "executive_biography",
            "content": "Jeffrey P. Bezos. Mr. Bezos founded Amazon.com in 1994 and has served as Executive Chair since July 2021. He has served as Chair of the Board since 1994 and served as Chief Executive Officer from May 1996 until July 2021, and as President from 1994 until June 1999 and again from October 2000 to July 2021.",
            "entity_name": "Jeffrey P. Bezos",
            "entity_type_entity": "Person",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "executive_biography",
            "content": "Andrew R. Jassy. Mr. Jassy has served as President and Chief Executive Officer since July 2021, CEO Amazon Web Services from April 2016 until July 2021, and Senior Vice President, Amazon Web Services, from April 2006 until April 2016.",
            "entity_name": "Andrew R. Jassy",
            "entity_type_entity": "Person",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "executive_biography",
            "content": "Douglas J. Herrington. Mr. Herrington has served as CEO Worldwide Amazon Stores since July 2022, Senior Vice President, North America Consumer from January 2015 to July 2022, and Senior Vice President, Consumables from May 2014 to December 2014.",
            "entity_name": "Douglas J. Herrington",
            "entity_type_entity": "Person",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "executive_biography",
            "content": "Brian T. Olsavsky. Mr. Olsavsky has served as Senior Vice President and Chief Financial Officer since June 2015, Vice President, Finance for the Global Consumer Business from December 2011 to June 2015, and numerous financial leadership roles across Amazon with global responsibility since April 2002.",
            "entity_name": "Brian T. Olsavsky",
            "entity_type_entity": "Person",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "executive_biography",
            "content": "Shelley L. Reynolds. Ms. Reynolds has served as Vice President, Worldwide Controller, and Principal Accounting Officer since April 2007.",
            "entity_name": "Shelley L. Reynolds",
            "entity_type_entity": "Person",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "executive_biography",
            "content": "Adam N. Selipsky. Mr. Selipsky has served as CEO Amazon Web Services since July 2021, Senior Vice President, Amazon Web Services from May 2021 until July 2021, President and CEO of Tableau Software from September 2016 until May 2021, and Vice President, Marketing, Sales and Support of Amazon Web Services from May 2005 to September 2016.",
            "entity_name": "Adam N. Selipsky",
            "entity_type_entity": "Person",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "executive_biography",
            "content": "David A. Zapolsky. Mr. Zapolsky has served as Senior Vice President, General Counsel, and Secretary since May 2014, Vice President, General Counsel, and Secretary from September 2012 to May 2014, and as Vice President and Associate General Counsel for Litigation and Regulatory matters from April 2002 until September 2012.",
            "entity_name": "David A. Zapolsky",
            "entity_type_entity": "Person",
            "valid_from": null,
            "valid_until": null
          }
        ],
