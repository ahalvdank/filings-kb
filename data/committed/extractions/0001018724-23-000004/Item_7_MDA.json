      "payload": {
        "chunks": [
          {
            "attributes": {
              "operating_income_usd": -2847000000,
              "revenue_usd": 315880000000,
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "North America sales increased 13% in 2022, compared to the prior year. The sales growth primarily reflects increased unit sales, including sales by third-party sellers, advertising sales, and subscription services. Increased unit sales were driven largely by our continued focus on price, selection, and convenience for our customers, including from our shipping offers.",
            "entity_name": "AMZN North America Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "operating_income_usd": -7746000000,
              "revenue_usd": 118007000000,
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "International sales decreased 8% in 2022, compared to the prior year, primarily due to the impact of changes in foreign currency exchange rates, partially offset by increased unit sales, including sales by third-party sellers, advertising sales, and subscription services.",
            "entity_name": "AMZN International Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "operating_income_usd": 22841000000,
              "revenue_usd": 80096000000,
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "AWS sales increased 29% in 2022, compared to the prior year. The sales growth primarily reflects increased customer usage, partially offset by pricing changes, primarily driven by long-term customer contracts.",
            "entity_name": "AMZN AWS Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "guidance_as_of": "2023-02-02",
              "section_type": "Item_7_MDA",
              "update_type": "initiation"
            },
            "chunk_type": "guidance",
            "content": "Net sales are expected to be between $121.0 billion and $126.0 billion, or to grow between 4% and 8% compared with first quarter 2022. This guidance anticipates an unfavorable impact of approximately 210 basis points from foreign exchange rates.",
            "entity_name": "AMZN Q1 2023 Net Sales Guidance",
            "entity_type_entity": "GuidanceUpdate",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "guidance_as_of": "2023-02-02",
              "section_type": "Item_7_MDA",
              "update_type": "initiation"
            },
            "chunk_type": "guidance",
            "content": "Operating income is expected to be between $0 and $4.0 billion, compared with $3.7 billion in first quarter 2022.",
            "entity_name": "AMZN Q1 2023 Operating Income Guidance",
            "entity_type_entity": "GuidanceUpdate",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "material_event",
            "content": "We funded the acquisition of MGM Holdings Inc. with cash on hand. We expect to fund the acquisitions of 1Life Healthcare, Inc. (One Medical) and iRobot Corporation with cash on hand.",
            "entity_name": "AMZN Acquisition of MGM Holdings Inc.",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "risk_factor",
            "content": "We also expect the current macroeconomic environment and enterprise customer cost optimization efforts to impact our AWS revenue growth rates. We expect some or all of these factors to continue to impact our operations into Q1 2023.",
            "entity_name": "AMZN Macroeconomic and AWS Enterprise Demand Risk",
            "entity_type_entity": "Risk",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "risk_factor",
            "content": "Currency volatilities may continue, which may significantly impact (either positively or negatively) our reported results and consolidated trends and comparisons.",
            "entity_name": "AMZN Foreign Currency Exchange Rate Risk",
            "entity_type_entity": "Risk",
            "valid_from": null,
