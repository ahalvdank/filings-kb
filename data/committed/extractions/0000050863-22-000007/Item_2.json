        "chunks": [
          {
            "attributes": {
              "section_type": "Item_2"
            },
            "chunk_type": "executive_biography",
            "content": "Patrick P. Gelsinger has been our Chief Executive Officer and a member of our Board of Directors since February 2021. He joined Intel from VMware, Inc., a provider of cloud computing and virtualization software and services, where he served as Chief Executive Officer from September 2012 to February 2021. Prior to joining VMware, Mr. Gelsinger served as President and Chief Operating Officer, EMC Information Infrastructure Products at EMC Corp., a data storage, information security and cloud computing company, from September 2009 to August 2012.",
            "entity_name": "Patrick P. Gelsinger",
            "entity_type_entity": "Person",
            "valid_from": "2022-01-26",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_2"
            },
            "chunk_type": "executive_biography",
            "content": "Sandra L. Rivera has served as our Executive Vice President and General Manager of the Data Center and AI Group since July 2021. In this role, she leads strategy and product development for our data center products, including Intel Xeon and FPGA products, and leads our overall AI strategy and product roadmap. Before her current role, Ms. Rivera served as our Chief People Officer from June 2019 to July 2021.",
            "entity_name": "Sandra L. Rivera",
            "entity_type_entity": "Person",
            "valid_from": "2022-01-26",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_2"
            },
            "chunk_type": "executive_biography",
            "content": "Steven R. Rodgers has been our Executive Vice President and General Counsel since January 2017 and oversees our legal, government, and trade groups. He previously led our legal and government groups as Senior Vice President and General Counsel from January 2015 to January 2017 and as Corporate Vice President and General Counsel from June 2014 to January 2015.",
            "entity_name": "Steven R. Rodgers",
            "entity_type_entity": "Person",
            "valid_from": "2022-01-26",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_2"
            },
            "chunk_type": "executive_biography",
            "content": "David Zinsner joined Intel in January 2022 as our Executive Vice President and Chief Financial Officer, overseeing our global finance organization. He joined Intel from Micron Technology, Inc., a manufacturer of memory and storage products, where he most recently served as Executive Vice President and Chief Financial Officer.",
            "entity_name": "David Zinsner",
            "entity_type_entity": "Person",
            "valid_from": "2022-01-26",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_2"
            },
            "chunk_type": "capital_return",
            "content": "We have an ongoing authorization, originally approved by our Board of Directors in 2005 and subsequently amended, to repurchase shares of our common stock in open market or negotiated transactions. As of December 25, 2021, we were authorized to repurchase up to $110.0 billion, of which $7.2 billion remained available.",
            "entity_name": "INTC Common Stock Repurchase Program Authorization",
            "entity_type_entity": "CapitalReturn",
            "valid_from": "2022-01-26",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_2",
              "units": "shares_in_millions_price_per_share_remaining_in_millions"
            },
            "chunk_type": "capital_return",
            "content": "Common stock repurchase activity under our publicly announced stock repurchase program during 2021 was as follows: December 27, 2020 - March 27, 202139.5 $61.12 $7,243 Total39.5",
            "entity_name": "INTC Q1-2021 Common Stock Repurchases",
            "entity_type_entity": "CapitalReturn",
            "valid_from": "2022-01-26",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_2",
              "source_table": "Consolidated Statements of Stockholders' Equity"
            },
            "chunk_type": "capital_return",
            "content": "Cash dividends declared ($1.39 per share of common stock)",
            "entity_name": "INTC FY2021 Cash Dividends",
            "entity_type_entity": "CapitalReturn",
            "valid_from": "2022-01-26",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_2"
            },
            "chunk_type": "material_event",
            "content": "For 2021, the results of our Intel Optane memory business are included in our DCG operating segment, and our NSG segment is comprised of our NAND memory business to align to the pending divestiture of our NAND memory business.",
            "entity_name": "INTC NAND Memory Business Divestiture",
            "entity_type_entity": "MaterialEvent",
            "valid_from": "2022-01-26",
            "valid_until": null
          },
