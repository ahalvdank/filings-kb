          {
            "attributes": {
              "section_type": "Item_2"
            },
            "chunk_type": "segment",
            "content": "CCG and DCG are our reportable operating segments. IOTG, Mobileye, NSG, and PSG do not meet the quantitative thresholds to qualify as reportable operating segments; however, we have elected to disclose the results of these non-reportable operating segments. Our Internet of Things portfolio, presented as Internet of Things, is comprised of the IOTG and Mobileye operating segments.",
            "entity_name": "INTC CCG Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2022-01-26",
            "valid_until": null
