      "extracted_at": "2026-06-22T06:44:55Z",
      "payload": {
        "chunks": [
          {
            "attributes": {
              "period": "FY2023",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "North America sales increased 12% in 2023, compared to the prior year. The sales growth primarily reflects increased unit sales, primarily by third-party sellers, advertising sales, and subscription services. Increased unit sales were driven largely by our continued focus on price, selection, and convenience for our customers, including from our shipping offers.",
            "entity_name": "AMZN North America Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2024-02-02",
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2023",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "The North America operating income in 2023, as compared to the operating loss in the prior year, is primarily due to increased unit sales and increased advertising sales, partially offset by increased shipping and fulfillment costs and increased technology and infrastructure costs.",
            "entity_name": "AMZN North America Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2024-02-02",
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2023",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "International sales increased 11% in 2023, compared to the prior year. The sales growth primarily reflects increased unit sales, primarily by third-party sellers, advertising sales, and subscription services. Increased unit sales were driven largely by our continued focus on price, selection, and convenience for our customers, including from our shipping offers. Changes in foreign exchange rates increased International net sales by $88 million in 2023.",
            "entity_name": "AMZN International Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2024-02-02",
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2023",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "The decrease in International operating loss in absolute dollars in 2023, compared to the prior year, is primarily due to increased unit sales and increased advertising sales, partially offset by increased fulfillment and shipping costs and increased technology and infrastructure costs.",
            "entity_name": "AMZN International Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2024-02-02",
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2023",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "AWS sales increased 13% in 2023, compared to the prior year. The sales growth primarily reflects increased customer usage, partially offset by pricing changes, primarily driven by long-term customer contracts.",
            "entity_name": "AMZN AWS Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2024-02-02",
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2023",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "The increase in AWS operating income in absolute dollars in 2023, compared to the prior year, is primarily due to increased sales, partially offset by increased payroll and related expenses and spending on technology infrastructure, both of which were primarily driven by additional investments to support AWS business growth.",
            "entity_name": "AMZN AWS Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2024-02-02",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA",
              "update_type": "confirmation"
            },
            "chunk_type": "guidance",
            "content": "Net sales are expected to be between $138.0 billion and $143.5 billion, or to grow between 8% and 13% compared with first quarter 2023. This guidance anticipates a favorable impact of approximately 40 basis points from foreign exchange rates.",
            "entity_name": "AMZN Q1 2024 Net Sales Guidance",
            "entity_type_entity": "GuidanceUpdate",
            "valid_from": "2024-02-02",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA",
              "update_type": "confirmation"
            },
            "chunk_type": "guidance",
            "content": "Operating income is expected to be between $8.0 billion and $12.0 billion, compared with $4.8 billion in first quarter 2023. This guidance includes approximately $0.9 billion lower depreciation expense due to an increase in the estimated useful life of our servers beginning on January 1, 2024.",
            "entity_name": "AMZN Q1 2024 Operating Income Guidance",
            "entity_type_entity": "GuidanceUpdate",
            "valid_from": "2024-02-02",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA",
              "update_type": "confirmation"
            },
            "chunk_type": "guidance",
            "content": "Cash capital expenditures were $58.3 billion, and $48.1 billion in 2022 and 2023, which primarily reflect investments in technology infrastructure (the majority of which is to support AWS business growth) and in additional capacity to support our fulfillment network, which investments we expect to increase in 2024.",
            "entity_name": "AMZN FY2024 Capital Expenditure Increase Guidance",
            "entity_type_entity": "GuidanceUpdate",
            "valid_from": "2024-02-02",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "material_event",
            "content": "We funded the acquisitions of MGM Holdings Inc. in 2022 and 1Life Healthcare, Inc. (One Medical) in 2023 with cash on hand.",
            "entity_name": "AMZN Acquisition of 1Life Healthcare (One Medical)",
            "entity_type_entity": "MaterialEvent",
            "valid_from": "2024-02-02",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "material_event",
            "content": "We funded the acquisitions of MGM Holdings Inc. in 2022 and 1Life Healthcare, Inc. (One Medical) in 2023 with cash on hand.",
            "entity_name": "AMZN Acquisition of MGM Holdings Inc.",
            "entity_type_entity": "MaterialEvent",
            "valid_from": "2024-02-02",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "material_event",
            "content": "In 2023, we invested $1.25 billion in a note from Anthropic, PBC, which is convertible into equity. We have an agreement that expires in Q1 2024 to invest up to an additional $2.75 billion in a second convertible note.",
            "entity_name": "AMZN Anthropic PBC $1.25B Convertible Note Investment",
            "entity_type_entity": "MaterialEvent",
            "valid_from": "2024-02-02",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "material_event",
            "content": "Other operating expense (income), net was $1.3 billion and $767 million during 2022 and 2023, and was primarily related to asset impairments for physical store closures in 2022 and for fulfillment network facilities and physical store closures in 2023, and the amortization of intangible assets.",
            "entity_name": "AMZN FY2023 Fulfillment Network and Physical Store Closure Restructuring",
            "entity_type_entity": "MaterialEvent",
            "valid_from": "2024-02-02",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "material_event",
            "content": "This guidance includes approximately $0.9 billion lower depreciation expense due to an increase in the estimated useful life of our servers beginning on January 1, 2024.",
            "entity_name": "AMZN Server Useful Life Accounting Change (January 2024)",
            "entity_type_entity": "MaterialEvent",
            "valid_from": "2024-02-02",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "capital_structure_event",
            "content": "We had no borrowings outstanding under the two unsecured revolving credit facilities or the commercial paper programs, we had $682 million of borrowings outstanding under the secured revolving credit facility, and the entire amount of the term loan has been repaid as of December 31, 2023.",
            "entity_name": "AMZN Term Loan Full Repayment (December 2023)",
            "entity_type_entity": "CapitalStructureEvent",
            "valid_from": "2024-02-02",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "risk_factor",
            "content": "We also expect the current macroeconomic environment and enterprise customer cost optimization efforts to impact our AWS revenue growth rates. We expect some or all of these factors to continue to impact our operations into Q1 2024.",
            "entity_name": "AMZN AWS Revenue Growth Headwinds from Macroeconomic Conditions and Enterprise Cost Optimization",
            "entity_type_entity": "Risk",
            "valid_from": "2024-02-02",
            "valid_until": null
          }
        ],
