      "payload": {
        "chunks": [
          {
            "attributes": {
              "section_type": "Item_3",
              "title": "Chairman of the Board and Chief Executive Officer"
            },
            "chunk_type": "executive_biography",
            "content": "Mr. Darren W. Woods became a Director and President of Exxon Mobil Corporation on January 1, 2016, and Chairman of the Board and Chief Executive Officer of Exxon Mobil Corporation on January 1, 2017, positions he continues to hold as of this filing date.",
            "entity_name": "Darren W. Woods",
            "entity_type_entity": "Person",
            "valid_from": "2022-02-23",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_3",
              "title": "Senior Vice President"
            },
            "chunk_type": "executive_biography",
            "content": "Mr. Neil A. Chapman was President of ExxonMobil Chemical Company and Vice President of Exxon Mobil Corporation January 1, 2015 – December 31, 2017. He became Senior Vice President of Exxon Mobil Corporation on January 1, 2018, a position he continues to hold as of this filing date.",
            "entity_name": "Neil A. Chapman",
            "entity_type_entity": "Person",
            "valid_from": "2022-02-23",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_3",
              "title": "Senior Vice President and Chief Financial Officer"
            },
            "chunk_type": "executive_biography",
            "content": "Ms. Kathryn A. Mikells was Chief Financial Officer and a member of the board of directors of Diageo plc November 2015 – June 2021. Prior to that time, she held Chief Financial Officer positions at Xerox, ADT, Nalco, and United Airlines, where she also served as Vice President of Investor Relations and Treasurer. She became Senior Vice President and Chief Financial Officer of Exxon Mobil Corporation on August 9, 2021, positions she continues to hold as of this filing date.",
            "entity_name": "Kathryn A. Mikells",
            "entity_type_entity": "Person",
            "valid_from": "2022-02-23",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_3",
              "title": "Senior Vice President"
            },
            "chunk_type": "executive_biography",
            "content": "Mr. Jack P. Williams, Jr. became Senior Vice President of Exxon Mobil Corporation on June 1, 2014, a position he continues to hold as of this filing date.",
            "entity_name": "Jack P. Williams, Jr.",
            "entity_type_entity": "Person",
            "valid_from": "2022-02-23",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_3",
              "title": "Vice President"
            },
            "chunk_type": "executive_biography",
            "content": "Mr. Ian S. Carr was Vice President, Strategy and Planning, ExxonMobil Refining & Supply Company May 1, 2014 – July 31, 2017. He was Vice President, Upstream Strategy and Planning, ExxonMobil Gas & Power Marketing Company August 1, 2017 – March 31, 2019. He was Vice President, Strategy and Portfolio Management, ExxonMobil Upstream Business Development Company April 1, 2019 – September 30, 2019. He was Senior Vice President, Fuels, ExxonMobil Fuels & Lubricants Company October 1, 2019 – Aug...",
            "entity_name": "Ian S. Carr",
            "entity_type_entity": "Person",
            "valid_from": "2022-02-23",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_3",
              "title": "Vice President"
            },
            "chunk_type": "executive_biography",
            "content": "Ms. Linda D. DuCharme was President of ExxonMobil Global Services Company August 1, 2016 – March 31, 2019. She became President of ExxonMobil Upstream Integrated Solutions Company April 1, 2019, and President of ExxonMobil Upstream Business Development Company and Vice President of Exxon Mobil Corporation on July 1, 2020, positions she continues to hold as of this filing date.",
            "entity_name": "Linda D. DuCharme",
            "entity_type_entity": "Person",
            "valid_from": "2022-02-23",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_3",
              "title": "Vice President and Controller"
            },
            "chunk_type": "executive_biography",
            "content": "Mr. Len M. Fox was Vice President, Chemical Business Services and Treasurer, ExxonMobil Chemical Company June 1, 2015 – January 31, 2020. He was Assistant Treasurer of Exxon Mobil Corporation February 1, 2020 – December 31, 2020. Following a special assignment, he became Vice President and Controller of Exxon Mobil Corporation on March 1, 2021, positions he continues to hold as of this filing date.",
            "entity_name": "Len M. Fox",
            "entity_type_entity": "Person",
            "valid_from": "2022-02-23",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_3",
              "title": "President, ExxonMobil Global Projects Company"
            },
            "chunk_type": "executive_biography",
            "content": "Mr. Jon M. Gibbs was Vice President, Asia Pacific and Middle East, ExxonMobil Development Company January 1, 2016 – January 14, 2019. He was Upstream Organization Design Team Lead, ExxonMobil Development Company January 15, 2019 – March 31, 2019. He was President, ExxonMobil Global Services Company April 1, 2019 – June 30, 2020. He was Senior Vice President, Global Project Delivery, ExxonMobil Global Projects Company July 1, 2020 – March 31, 2021. He became President of ExxonMobil Global ...",
            "entity_name": "Jon M. Gibbs",
            "entity_type_entity": "Person",
            "valid_from": "2022-02-23",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_3",
              "title": "Vice President – Investor Relations and Secretary"
            },
            "chunk_type": "executive_biography",
            "content": "Mr. Stephen A. Littleton was Assistant Controller of Exxon Mobil Corporation June 1, 2015 – April 30, 2018. He was Vice President, Downstream Business Services and Downstream Controller May 1, 2018 – March 14, 2020. He became Vice President – Investor Relations and Secretary of Exxon Mobil Corporation on March 15, 2020, positions he continues to hold as of this filing date.",
            "entity_name": "Stephen A. Littleton",
            "entity_type_entity": "Person",
            "valid_from": "2022-02-23",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_3",
              "title": "Vice President"
            },
            "chunk_type": "executive_biography",
            "content": "Mr. Liam M. Mallon was President of ExxonMobil Development Company January 1, 2017 – March 31, 2019. He became President of ExxonMobil Upstream Oil & Gas Company and Vice President of Exxon Mobil Corporation on April 1, 2019, positions he continues to hold as of this filing date.",
            "entity_name": "Liam M. Mallon",
            "entity_type_entity": "Person",
            "valid_from": "2022-02-23",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_3",
              "title": "Vice President"
            },
            "chunk_type": "executive_biography",
            "content": "Ms. Karen T. McKee was Vice President, Basic Chemicals, ExxonMobil Chemical Company May 1, 2014 – July 31, 2017. She was Senior Vice President, Basic Chemicals, Integration & Growth, ExxonMobil Chemical Company August 1, 2017 – March 31, 2019. She became President of ExxonMobil Chemical Company and Vice President of Exxon Mobil Corporation on April 1, 2019, positions she continues to hold as of this filing date.",
            "entity_name": "Karen T. McKee",
            "entity_type_entity": "Person",
            "valid_from": "2022-02-23",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_3",
              "title": "Vice President and General Counsel"
            },
            "chunk_type": "executive_biography",
            "content": "Mr. Craig S. Morford was Chief Legal and Compliance Officer of Cardinal Heath, Inc. prior to joining Exxon Mobil Corporation in May 2019. He was Deputy General Counsel of Exxon Mobil Corporation May 1, 2019 – October 31, 2020. He became Vice President and General Counsel of Exxon Mobil Corporation on November 1, 2020, positions he continues to hold as of this filing date.",
            "entity_name": "Craig S. Morford",
            "entity_type_entity": "Person",
            "valid_from": "2022-02-23",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_3",
              "title": "Vice President, Treasurer and General Tax Counsel"
            },
            "chunk_type": "executive_biography",
            "content": "Mr. James M. Spellings, Jr. became Vice President and General Tax Counsel of Exxon Mobil Corporation on March 1, 2010, and Treasurer of Exxon Mobil Corporation on April 1, 2020, positions he continues to hold as of this filing date.",
            "entity_name": "James M. Spellings, Jr.",
            "entity_type_entity": "Person",
            "valid_from": "2022-02-23",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_3",
              "title": "Vice President – Corporate Strategic Planning"
            },
            "chunk_type": "executive_biography",
            "content": "Mr. Theodore J. Wojnar, Jr. was President of ExxonMobil Research and Engineering Company April 1, 2011 – July 31, 2017. He became Vice President – Corporate Strategic Planning of Exxon Mobil Corporation on August 1, 2017, a position he continues to hold as of this filing date.",
            "entity_name": "Theodore J. Wojnar, Jr.",
            "entity_type_entity": "Person",
            "valid_from": "2022-02-23",
            "valid_until": null
          }
        ],
