          {
            "attributes": {
              "section_type": "Item_2"
            },
            "chunk_type": "material_event",
            "content": "In addition, ExxonMobil completed the acquisition of Pioneer, increasing the Permian Basin acreage and production capacity.",
            "entity_name": "XOM Acquisition of Pioneer Natural Resources",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_2"
            },
            "chunk_type": "material_event",
            "content": "In December 2024, the Corporation completed a transfer of 100 percent of the shares in its Nigeria affiliate, Mobil Producing Nigeria Unlimited, following the receipt of and compliance with conditions precedent specified in government approvals.",
            "entity_name": "XOM Divestiture of Mobil Producing Nigeria Unlimited",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_2"
            },
            "chunk_type": "material_event",
            "content": "ExxonMobil relinquished 2.6 million net offshore acres and sold a portion of its interests in onshore production facilities. The sale of the remaining onshore assets is expected to be completed in early 2025 resulting in a full Upstream operations exit from the country.",
            "entity_name": "XOM Argentina Upstream Operations Exit",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_2"
            },
            "chunk_type": "material_event",
            "content": "The Corporation announced a sales agreement relating to ExxonMobil's ownership interest in this asset and expects the transaction to close in 2025.",
            "entity_name": "XOM Karlsruhe Refinery Interest Sale",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_2"
            },
            "chunk_type": "material_event",
            "content": "In 2024, the Company shut down a portion of its Gravenchon chemical operations including the steamcracker and related derivatives units.",
            "entity_name": "XOM Gravenchon Chemical Operations Shutdown 2024",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_2"
            },
            "chunk_type": "material_event",
            "content": "Groningen field permanent closure was codified in the Dutch mining law on April 19, 2024.",
            "entity_name": "XOM Groningen Field Permanent Closure",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          }
