      "payload": {
        "chunks": [
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "material_event",
            "content": "JPMorgan Chase & Co. (\"JPMorgan Chase\" or the \"Firm\", NYSE: JPM), a financial holding company incorporated under Delaware law in 1968, is a leading financial services firm based in the United States of America (\"U.S.\"), with operations worldwide. JPMorgan Chase had $3.7 trillion in assets and $292.3 billion in stockholders' equity as of December 31, 2022.",
            "entity_name": "JPMorgan Chase & Co.",
            "entity_type_entity": "Company",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "segment",
            "content": "For management reporting purposes, JPMorgan Chase's activities are organized into four major reportable business segments, as well as a Corporate segment. The Firm's consumer business is the Consumer & Community Banking (\"CCB\") segment. The Firm's wholesale business segments are the Corporate & Investment Bank (\"CIB\"), Commercial Banking (\"CB\"), and Asset & Wealth Management (\"AWM\").",
            "entity_name": "JPM Consumer & Community Banking Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "note": "firmwide employee headcount context for segment workforce table",
              "section_type": "Item_1"
            },
            "chunk_type": "segment",
            "content": "As of December 31, 2022, JPMorgan Chase had 293,723 employees globally, an increase of 22,698 employees from the prior year. The increase was primarily attributable to additional employees in technology and operations, as well as front office.",
            "entity_name": "JPM Consumer & Community Banking Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "legal_proceeding",
            "content": "The Firm is subject to obligations under the terms of a Deferred Prosecution Agreement entered into with the Department of Justice on September 29, 2020 relating to precious metals and U.S. Treasuries markets investigations as well as under a related order issued by the CFTC.",
            "entity_name": "JPMorgan Chase DOJ Deferred Prosecution Agreement 2020",
            "entity_type_entity": "LegalProceeding",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "esg_commitment",
            "content": "The Firm has global Diversity, Equity & Inclusion centers of excellence that lead the Firm's strategy in supporting its commitments to create more equity and lasting impact in communities, and strengthen its inclusive culture.",
            "entity_name": "JPMorgan Chase Diversity, Equity and Inclusion Commitment",
            "entity_type_entity": "ESGCommitment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "esg_commitment",
            "content": "The Firm's commitment to diversity, equity and inclusion for all employees includes compensation review processes that seek to ensure that the Firm's employees are paid equitably and competitively for the work they do.",
            "entity_name": "JPMorgan Chase Diversity, Equity and Inclusion Commitment",
            "entity_type_entity": "ESGCommitment",
            "valid_from": null,
            "valid_until": null
          }
        ],
