      "payload": {
        "chunks": [
          {
            "attributes": {
              "period": "FY2024",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "North America sales increased 10% in 2024, compared to the prior year. The sales growth primarily reflects increased unit sales, including sales by third-party sellers, advertising sales, and subscription services. Increased unit sales were driven largely by our continued focus on price, selection, and convenience for our customers, including from our fast shipping offers.",
            "entity_name": "AMZN North America Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2025-02-06",
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2024",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "The increase in North America operating income in 2024, compared to the prior year, is primarily due to increased unit sales and increased advertising sales, partially offset by increased fulfillment and shipping costs.",
            "entity_name": "AMZN North America Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2025-02-06",
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2024",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "International sales increased 9% in 2024, compared to the prior year. The sales growth primarily reflects increased unit sales, including sales by third-party sellers, advertising sales, and subscription services. Increased unit sales were driven largely by our continued focus on price, selection, and convenience for our customers, including from our fast shipping offers.",
            "entity_name": "AMZN International Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2025-02-06",
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2024",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "The International operating income in 2024, as compared to the operating loss in the prior year, is primarily due to increased unit sales and increased advertising sales, partially offset by increased shipping and fulfillment costs.",
            "entity_name": "AMZN International Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2025-02-06",
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2024",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "AWS sales increased 19% in 2024, compared to the prior year. The sales growth primarily reflects increased customer usage, partially offset by pricing changes primarily driven by long-term customer contracts.",
            "entity_name": "AMZN AWS Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2025-02-06",
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2024",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "The increase in AWS operating income in 2024, compared to the prior year, is primarily due to increased sales, decreased payroll and related expenses, and a reduction in depreciation and amortization expense from our change in the estimated useful life of our servers, partially offset by spending on technology infrastructure that was primarily driven by additional investments to support AWS business growth.",
            "entity_name": "AMZN AWS Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2025-02-06",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA",
              "update_type": "confirmation"
            },
            "chunk_type": "guidance",
            "content": "Net sales are expected to be between $151.0 billion and $155.5 billion, or to grow between 5% and 9% compared with first quarter 2024. This guidance anticipates an unusually large, unfavorable impact of approximately $2.1 billion, or 150 basis points, from foreign exchange rates.",
            "entity_name": "AMZN Q1 2025 Net Sales Guidance",
            "entity_type_entity": "GuidanceUpdate",
            "valid_from": "2025-02-06",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA",
              "update_type": "confirmation"
            },
            "chunk_type": "guidance",
            "content": "Operating income is expected to be between $14.0 billion and $18.0 billion, compared with $15.3 billion in first quarter 2024.",
            "entity_name": "AMZN Q1 2025 Operating Income Guidance",
            "entity_type_entity": "GuidanceUpdate",
            "valid_from": "2025-02-06",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA",
              "update_type": "confirmation"
            },
            "chunk_type": "guidance",
            "content": "We expect cash capital expenditures to increase in 2025, primarily driven by investments in technology infrastructure.",
            "entity_name": "AMZN 2025 Capital Expenditures Guidance",
            "entity_type_entity": "GuidanceUpdate",
            "valid_from": "2025-02-06",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "material_event",
            "content": "In Q3 2023, we invested $1.25 billion in a convertible note from Anthropic, PBC. In Q1 2024, we invested $2.75 billion in a second convertible note. In Q4 2024, we entered into an agreement and invested $1.3 billion in a third convertible note, and will invest an additional $2.7 billion by Q4 2025.",
            "entity_name": "AMZN Anthropic Convertible Note Investment Series",
            "entity_type_entity": "MaterialEvent",
            "valid_from": "2025-02-06",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "material_event",
            "content": "The increase in technology and infrastructure costs in 2024, compared to the prior year, is primarily due to an increase in spending on infrastructure, partially offset by decreased payroll and related costs associated with technical teams responsible for expanding our existing products and services and initiatives to introduce new products and service offerings and a reduction in depreciation and amortization expense from our change in the estimated useful life of our servers.",
            "entity_name": "AMZN Server Useful Life Accounting Change",
            "entity_type_entity": "MaterialEvent",
            "valid_from": "2025-02-06",
            "valid_until": null
          }
        ],
