      "payload": {
        "chunks": [
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "executive_biography",
            "content": "We continue this work under the leadership of Alphabet and Google CEO, Sundar Pichai.",
            "entity_name": "Sundar Pichai",
            "entity_type_entity": "Person",
            "valid_from": "2024-01-30",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "segment",
            "content": "Google Services generates revenues primarily by delivering both performance and brand advertising that appears on Google Search & other properties, YouTube, and Google Network partners' properties (\"Google Network properties\"). We continue to invest in both performance and brand advertising and seek to improve the measurability of advertising so advertisers understand the effectiveness of their campaigns.",
            "entity_name": "GOOGL Google Services Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2024-01-30",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "segment",
            "content": "Through our Google Cloud Platform and Google Workspace offerings, Google Cloud generates revenues primarily from consumption-based fees and subscriptions for infrastructure, platform, collaboration tools and other cloud services.",
            "entity_name": "GOOGL Google Cloud Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2024-01-30",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "segment",
            "content": "Revenues from Other Bets are generated primarily from the sale of healthcare-related services and internet services.",
            "entity_name": "GOOGL Other Bets Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2024-01-30",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "esg_commitment",
            "content": "In 2021, we set an ambitious goal to achieve net-zero emissions across all of our operations and value chain, by 2030. To accomplish this, we aim to reduce 50% of our combined Scope 1, Scope 2 (market-based), and Scope 3 absolute emissions (versus our 2019 baseline) before 2030, and plan to invest in nature-based and technology-based carbon removal solutions to neutralize our remaining emissions.",
            "entity_name": "GOOGL 2030 Net-Zero Emissions Commitment",
            "entity_type_entity": "ESGCommitment",
            "valid_from": "2024-01-30",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "esg_commitment",
            "content": "That is why we set a goal to run on 24/7 carbon-free energy (CFE) on every grid where we operate by 2030.",
            "entity_name": "GOOGL 2030 24/7 Carbon-Free Energy Goal",
            "entity_type_entity": "ESGCommitment",
            "valid_from": "2024-01-30",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "esg_commitment",
            "content": "we have set goals to replenish 120% of the freshwater volume we consume, on average, across our offices and data centers by 2030 and to help restore and improve the quality of water and health of ecosystems in the communities where we operate.",
            "entity_name": "GOOGL 2030 120% Freshwater Replenishment Goal",
            "entity_type_entity": "ESGCommitment",
            "valid_from": "2024-01-30",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "esg_commitment",
            "content": "In 2020, we shared our aspiration to help individuals, cities, and other partners collectively reduce one gigaton of their carbon equivalent emissions annually by 2030.",
            "entity_name": "GOOGL 2030 1 Gigaton Carbon Reduction Aspiration",
            "entity_type_entity": "ESGCommitment",
            "valid_from": "2024-01-30",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "esg_commitment",
            "content": "At Alphabet, we are committed to making diversity, equity, and inclusion part of everything we do and to growing a workforce that is representative of the users we serve.",
            "entity_name": "GOOGL DEI Workforce Commitment",
            "entity_type_entity": "ESGCommitment",
            "valid_from": "2024-01-30",
            "valid_until": null
          }
        ],
