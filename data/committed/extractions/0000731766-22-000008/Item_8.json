      "payload": {
        "chunks": [
          {
            "attributes": {
              "note": "Note 1 - Description of Business",
              "section_type": "Item_8"
            },
            "chunk_type": "segment",
            "content": "Our two distinct, yet complementary business platforms — Optum and UnitedHealthcare — are working to help build a modern, high-performing health system through improved access, affordability, outcomes and experiences for the individuals and organizations we are privileged to serve.",
            "entity_name": "UNH UnitedHealthcare Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2022-02-15",
            "valid_until": null
          },
          {
            "attributes": {
              "note": "Note 2 - Products and Services",
              "section_type": "Item_8"
            },
            "chunk_type": "segment",
            "content": "Optum Health's service revenues include net patient service revenues recorded based upon established billing rates, less allowances for contractual adjustments, and are recognized as services are provided. For its financial services offerings, Optum Health charges fees and earns investment income on managed funds.",
            "entity_name": "UNH Optum Health Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2022-02-15",
            "valid_until": null
          },
          {
            "attributes": {
              "note": "Note 2 - Products and Services",
              "section_type": "Item_8"
            },
            "chunk_type": "segment",
            "content": "Optum Insight provides software and information products, advisory consulting arrangements and managed services outsourcing contracts, which may be delivered over several years. Optum Insight revenues are generally recognized over time and measured each period based on the progress to date as services are performed or made available to customers.",
            "entity_name": "UNH Optum Insight Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2022-02-15",
            "valid_until": null
          },
          {
            "attributes": {
              "note": "Note 2 - Products and Services",
              "section_type": "Item_8"
            },
            "chunk_type": "segment",
            "content": "For the Company's Optum Rx pharmacy care services business, the majority of revenues are derived from products sold through a contracted network of retail pharmacies or home delivery, specialty and community health pharmacies. Product revenues include the cost of pharmaceuticals (net of rebates), a negotiated dispensing fee and customer co-payments for drugs dispensed through the Company's home delivery, specialty and community pharmacies.",
            "entity_name": "UNH Optum Rx Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": "2022-02-15",
            "valid_until": null
          },
          {
            "attributes": {
              "columns": "2021, 2020, 2019",
              "section_type": "Item_8",
              "statement": "Consolidated Statements of Cash Flows"
            },
            "chunk_type": "capital_return",
            "content": "Common share repurchases(5,000)(4,250)(5,500)",
            "entity_name": "UNH FY2021 Common Share Repurchases",
            "entity_type_entity": "CapitalReturn",
            "valid_from": "2022-02-15",
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_8",
              "statement": "Consolidated Statements of Changes in Equity"
            },
            "chunk_type": "capital_return",
            "content": "Cash dividends paid on common shares ($5.60 per share) (5,280)",
            "entity_name": "UNH FY2021 Cash Dividends",
            "entity_type_entity": "CapitalReturn",
            "valid_from": "2022-02-15",
            "valid_until": null
          },
          {
            "attributes": {
              "columns": "2021, 2020, 2019",
              "section_type": "Item_8",
              "statement": "Consolidated Statements of Cash Flows"
            },
            "chunk_type": "capital_structure_event",
            "content": "Proceeds from issuance of long-term debt6,933 4,864 5,444",
            "entity_name": "UNH FY2021 Long-Term Debt Issuance",
            "entity_type_entity": "CapitalStructureEvent",
            "valid_from": "2022-02-15",
            "valid_until": null
          },
          {
            "attributes": {
              "note": "Note 2 - ACA Tax",
              "section_type": "Item_8"
            },
            "chunk_type": "material_event",
            "content": "The Health Insurance Tax was permanently repealed by Congress, effective January 1, 2021. The permanent repeal of the tax impacts year-over-year comparability of our financial statements, including revenues, operating costs, medical care ratio (MCR), operating cost ratio, effective tax rate and cash flows from operations.",
            "entity_name": "UNH ACA Health Insurance Tax Permanent Repeal",
            "entity_type_entity": "MaterialEvent",
            "valid_from": "2022-02-15",
            "valid_until": null
          }
