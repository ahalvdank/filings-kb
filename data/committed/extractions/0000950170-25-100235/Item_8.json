          {
            "attributes": {
              "section_type": "Item_8"
            },
            "chunk_type": "executive_biography",
            "content": "Reid Hoffman, a member of our Board of Directors, is a co-founder of and serves on the board of directors of Inflection. As of the date of the agreement with Inflection, Reprogrammed Interchange LLC (\"Reprogrammed\") and entities affiliated with Greylock Ventures (\"Greylock\") each held less than a 10% equity interest in Inflection. Mr. Hoffman did not participate in any portions of the meetings of our Board of Directors or any committee thereof to review and approve the transaction with Inflection.",
            "entity_name": "Reid Hoffman",
            "entity_type_entity": "Person",
