          {
            "attributes": {
              "section_type": "Item_8"
            },
            "chunk_type": "material_event",
            "content": "In August 2024, we announced changes to the composition of our segments. These changes align our segments with how we currently manage our business, most notably bringing the commercial components of Microsoft 365 together in the Productivity and Business Processes segment. Beginning in fiscal year 2025, the information that our chief operating decision maker is regularly provided and reviews for purposes of allocating resources and assessing performance reflects these segment changes. Prior period segment information has been recast to conform to the way we internally manage and monitor our business during fiscal year 2025.",
            "entity_name": "MSFT August 2024 Segment Composition Changes",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_8"
            },
            "chunk_type": "material_event",
            "content": "We have an investment in OpenAI Global, LLC (\"OpenAI\") and have made total funding commitments of $13 billion. The investment is accounted for under the equity method of accounting.",
            "entity_name": "MSFT OpenAI Global LLC $13B Investment Commitment",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "other_net_fy2024_millions": -1319,
              "other_net_fy2025_millions": -4725,
              "section_type": "Item_8"
            },
            "chunk_type": "material_event",
            "content": "Other, net primarily reflects net recognized losses on equity method investments, including OpenAI.",
            "entity_name": "MSFT OpenAI Global LLC $13B Investment Commitment",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
