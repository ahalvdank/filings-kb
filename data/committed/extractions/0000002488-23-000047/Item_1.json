      "payload": {
        "chunks": [
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "segment",
            "content": "the Data Center segment, which primarily includes server CPUs and GPUs, DPUs, FPGAs, and Adaptive SoC products for data centers;",
            "entity_name": "AMD Data Center Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "segment",
            "content": "the Client segment, which primarily includes CPUs, APUs, and chipsets for desktop and notebook personal computers;",
            "entity_name": "AMD Client Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "segment",
            "content": "the Gaming segment, which primarily includes discrete GPUs, semi-custom SoC products and development services;",
            "entity_name": "AMD Gaming Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "segment",
            "content": "the Embedded segment, which primarily includes embedded CPUs, GPUs, APUs, FPGAs and Adaptive SoC products.",
            "entity_name": "AMD Embedded Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "material_event",
            "content": "With the acquisition of Xilinx, Inc. (XIlinx) in February 2022, our product portfolio now includes FPGAs and Adaptive SoCs used in the data center and embedded markets.",
            "entity_name": "AMD Acquisition of Xilinx, Inc.",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "material_event",
            "content": "Also, with the acquisition of Pensando Systems, Inc. in May 2022, we offer high-performance DPUs and next generation data center solutions.",
            "entity_name": "AMD Acquisition of Pensando Systems, Inc.",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "legal_proceeding",
            "content": "We have been named as a responsible party on Superfund clean-up orders for three sites in Sunnyvale, California that are on the National Priorities List. Since 1981, we have discovered hazardous material releases to the groundwater from former underground tanks and proceeded to investigate and conduct remediation at these three sites.",
            "entity_name": "AMD Sunnyvale Superfund Environmental Remediation",
            "entity_type_entity": "LegalProceeding",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "legal_proceeding",
            "content": "To address anticipated future remediation costs under the orders, we have computed and recorded an estimated environmental liability of approximately $3.9 million and have not recorded any potential insurance recoveries in determining the estimated costs of the cleanup.",
            "entity_name": "AMD Sunnyvale Superfund Environmental Remediation",
            "entity_type_entity": "LegalProceeding",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "executive_biography",
            "content": "We are proud to be led by a highly regarded CEO who has won many esteemed awards for her business and leadership prowess. In 2022, Dr. Lisa Su was listed among \"Fortune's Most Powerful Women\". In the last two years, she also received the \"Woman Innovation Award\" from the Global Semiconductor Alliance and was listed among Barron's World's Best CEOs and Forbes' World's Most Powerful Women.",
            "entity_name": "Lisa Su",
            "entity_type_entity": "Person",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "esg_commitment",
            "content": "Our diverse and inclusive workforce encourages employees to share their opinions and different perspectives. We believe that building a diverse talent pipeline, encouraging a culture of respect and belonging, and increasing inclusion of unique and underrepresented voices makes our Company stronger.",
            "entity_name": "AMD Diversity, Belonging and Inclusion Program",
            "entity_type_entity": "ESGCommitment",
            "valid_from": null,
            "valid_until": null
          }
        ],
