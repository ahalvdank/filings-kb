  "parts": [
    {
      "extracted_at": "2026-07-19T13:42:38Z",
      "payload": {
        "chunks": [
          {
            "attributes": {
              "period": "FY2025",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "Revenues were $402.8 billion, an increase of 15% year over year, primarily driven by an increase in Google Services revenues of $37.8 billion, or 12%, and an increase in Google Cloud revenues of $15.5 billion, or 36%.",
            "entity_name": "GOOGL Google Services Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2025",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "Google Services operating income increased $18.1 billion from 2024 to 2025. The increase in operating income was primarily driven by an increase in revenues, partially offset by an increase in expenses related to legal and other matters, TAC, and content acquisition costs.",
            "entity_name": "GOOGL Google Services Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2025",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "Google Cloud revenues increased $15.5 billion from 2024 to 2025, primarily driven by growth in Google Cloud Platform largely from infrastructure and platform services.",
            "entity_name": "GOOGL Google Cloud Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2025",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "Google Cloud operating income increased $7.8 billion from 2024 to 2025. The increase in operating income was primarily driven by an increase in revenues, partially offset by increases in usage costs for technical infrastructure and employee compensation expenses.",
            "entity_name": "GOOGL Google Cloud Segment",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2025",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "Google Search & other revenues increased $26.4 billion from 2024 to 2025. The overall growth was driven by interrelated factors including increases in search queries resulting from growth in user adoption and usage on mobile devices; growth in advertiser spending; and improvements we have made in ad formats and delivery.",
            "entity_name": "GOOGL Google Search and Other",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2025",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "YouTube ads revenues increased $4.2 billion from 2024 to 2025. The growth was driven by our direct response advertising products followed by our brand advertising products, both of which benefited from increased spending by our advertisers.",
            "entity_name": "GOOGL YouTube Ads",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2025",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "Google Network revenues decreased $567 million from 2024 to 2025, primarily due to a decrease in AdSense revenues, partially offset by an increase in AdMob revenues.",
            "entity_name": "GOOGL Google Network",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2025",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "Google subscriptions, platforms, and devices revenues increased $7.7 billion from 2024 to 2025. The growth was primarily driven by an increase in subscriptions revenues. This increase was primarily due to the contribution from growth in paid subscriptions across both YouTube services and Google One.",
            "entity_name": "GOOGL Google Subscriptions Platforms and Devices",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2025",
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "segment",
            "content": "Other Bets operating loss increased $3.1 billion from 2024 to 2025. The increase in operating loss was primarily driven by an increase in employee compensation expenses largely due to an increase in a valuation-based compensation charge related to Waymo.",
            "entity_name": "GOOGL Other Bets",
            "entity_type_entity": "RevenueSegment",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "period": "FY2026",
              "section_type": "Item_7_MDA",
              "update_type": "confirmation"
            },
            "chunk_type": "guidance",
            "content": "In 2026, we expect to significantly increase, relative to 2025, our investment in our technical infrastructure, including servers and network equipment, and data centers.",
            "entity_name": "GOOGL FY2026 Technical Infrastructure Capex Guidance",
            "entity_type_entity": "GuidanceUpdate",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "material_event",
            "content": "In March 2025, we entered into a definitive agreement to acquire Wiz, Inc. (\"Wiz\"), a leading cloud security platform, for $32.0 billion, subject to closing adjustments, in an all-cash transaction. The acquisition of Wiz is expected to close in 2026, subject to customary closing conditions, including the receipt of regulatory approvals.",
            "entity_name": "GOOGL Pending Acquisition of Wiz Inc.",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "material_event",
            "content": "In December 2025, we entered into a definitive agreement to acquire Intersect, which provides data center and energy infrastructure solutions, for $4.8 billion in cash, plus the assumption of debt. The acquisition of Intersect is expected to close in the first half of 2026, subject to customary closing conditions.",
            "entity_name": "GOOGL Pending Acquisition of Intersect",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "material_event",
            "content": "General and administrative expenses increased $7.3 billion from 2024 to 2025, primarily driven by an increase in expenses related to legal and other matters of $6.2 billion, largely the result of the $3.5 billion EC fine accrued in the third quarter of 2025 and a $1.4 billion legal accrual made in the second quarter of 2025.",
            "entity_name": "GOOGL EC Fine Accrual Q3 2025",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "material_event",
            "content": "Changes to US tax law enacted on July 4, 2025, allow for immediate expensing of domestic research and experimentation costs, accelerated depreciation on eligible capital expenditures, and other tax law changes impacting 2025 with certain changes effective in 2026. These changes are reflected in our results for the year ended December 31, 2025.",
            "entity_name": "GOOGL US Tax Law Changes July 2025",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "material_event",
            "content": "Other Bets operating loss of $7.5 billion for the year ended December 31, 2025 included a $2.1 billion employee compensation charge recognized in the fourth quarter for Waymo, primarily reflected in research and development expenses, based on estimated stock valuation.",
            "entity_name": "GOOGL Waymo Q4 2025 Valuation-Based Compensation Charge",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "capital_return",
            "content": "During 2025, we repurchased and subsequently retired 240 million shares for $45.4 billion.",
            "entity_name": "GOOGL FY2025 Share Repurchases",
            "entity_type_entity": "CapitalReturn",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "capital_return",
            "content": "In April 2025, the company's Board of Directors authorized an additional $70.0 billion share repurchase program for its Class A and Class C shares. As of December 31, 2025, $69.5 billion remained available for Class A and Class C share repurchases.",
            "entity_name": "GOOGL April 2025 $70B Share Repurchase Authorization",
            "entity_type_entity": "CapitalReturn",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "capital_return",
            "content": "In April 2025, the company's Board of Directors increased the quarterly cash dividend by 5% to $0.21 per share of outstanding Class A, Class B, and Class C shares.",
            "entity_name": "GOOGL April 2025 Quarterly Dividend Increase",
            "entity_type_entity": "CapitalReturn",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "capital_structure_event",
            "content": "May 2025: We issued $5.0 billion of US dollar-denominated fixed-rate senior unsecured notes with a weighted-average coupon rate of 4.89%, and a weighted-average maturity of approximately 24 years. We also issued €6.75 billion of euro-denominated fixed-rate senior unsecured notes with a weighted-average coupon rate of 3.31%, and a weighted-average maturity of approximately 14 years.",
            "entity_name": "GOOGL May 2025 Senior Unsecured Notes Issuance",
            "entity_type_entity": "CapitalStructureEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "capital_structure_event",
            "content": "November 2025: We issued $500 million of US dollar-denominated floating-rate senior unsecured notes and $17.0 billion of US dollar-denominated fixed-rate senior unsecured notes with a weighted-average coupon rate of 4.92% and a weighted-average maturity of approximately 20 years. We also issued €6.5 billion of euro-denominated fixed-rate senior unsecured notes with a weighted-average coupon rate of 3.44% and a weighted-average maturity of approximately 16 years.",
            "entity_name": "GOOGL November 2025 Senior Unsecured Notes Issuance",
            "entity_type_entity": "CapitalStructureEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "risk_factor",
            "content": "We are monitoring ongoing developments surrounding international trade and the macroeconomic environment. As a result of volatility in international trade and financial markets, we may experience direct and indirect effects on our business, operations, and financial results.",
            "entity_name": "GOOGL International Trade and Macroeconomic Volatility Risk",
            "entity_type_entity": "Risk",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_7_MDA"
            },
            "chunk_type": "risk_factor",
            "content": "As more countries enact these global minimum tax rules, our effective tax rate and cash tax payments could increase.",
            "entity_name": "GOOGL OECD Global Minimum Tax Risk",
            "entity_type_entity": "Risk",
            "valid_from": null,
            "valid_until": null
          }
        ],
