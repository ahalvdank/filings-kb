          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "legal_proceeding",
            "content": "The Firm is subject to obligations under the terms of a Deferred Prosecution Agreement entered into with the Department of Justice on September 29, 2020 relating to precious metals and U.S. Treasuries markets investigations as well as under a related order issued by the CFTC.",
            "entity_name": "JPM DOJ Deferred Prosecution Agreement 2020",
            "entity_type_entity": "LegalProceeding",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "material_event",
            "content": "In September 2021, the Firm launched a retail bank in the U.K. operating through J.P. Morgan Europe Limited (\"JPMEL\") and acquired Nutmeg Saving and Investment Limited, a U.K. online digital investment manager (\"Nutmeg\").",
            "entity_name": "JPM Acquisition of Nutmeg Saving and Investment Limited",
            "entity_type_entity": "MaterialEvent",
            "valid_from": null,
            "valid_until": null
          },
          {
            "attributes": {
              "section_type": "Item_1"
            },
            "chunk_type": "esg_commitment",
            "content": "The Firm has global Diversity, Equity & Inclusion centers of excellence, several of which were launched in 2021, that lead the Firm's strategy in supporting its commitments to create more equity and lasting impact in communities, and strengthen its inclusive culture.",
            "entity_name": "JPM Diversity Equity and Inclusion Program",
